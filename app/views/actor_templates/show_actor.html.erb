<h1>Movie # <%=@the_actor.id%> </h1>

<a href="/directors" class="btn btn-block btn-outline-secondary">
  Go back
</a>

&nbsp;|&nbsp;

<a href="/delete_director/4027" class="btn btn-block btn-outline-secondary">
  Delete director
  <small>(Building tdis link is not required. It's an optional stretch goal; but, you have tde tools if you want to give it a try.)</small>
</a>

<dl> 
  <dt>
    Name
  </dt>
  <dd>
    <%=@the_actor.name%>
  </dd>

  <dt>
    Dob
  </dt>
  <dd>
    <%=@the_actor.dob%>
  </dd>

  <dt>
    Bio
  </dt>
  <dd> 
  <%=@the_actor.bio%>
  </dd>

  <dt>
    Image
  </dt>
  <dd>
   <img src = "http://robohash.org/<%=@the_actor.image%>">
  </dd>
  <dt>
    Created at
  </dt>
  <dd>
   <%= time_ago_in_words(@the_actor.created_at)%> ago
  </dd>

  <dt>
    Updated at
  </dt>
  <dd>
  <%= time_ago_in_words(@the_actor.updated_at)%> ago
  </dd>
</dl>


<table border = "1">
<% @the_characters.each do |character| %>
     <% p character %>
      <tr>
        <% film = Movie.where( :id => character.movie_id).at(0) %>
        <td><%= film.title %></td>
        <td><%= film.year %></td>
        <% director = Director.where( :id => film.director_id).at(0) %>
        <td>
          <%= director.name %>
        </td>
        <td>
          <%= character.name %>
        </td>
        <td><a href="/movies/<%= film.id %>">Show details</a></td>
      </tr>
    <% end %>
    </table>
    